{
  "name": "mg-svg-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4179",
    "cli": "node bin/mgsvg.mjs",
