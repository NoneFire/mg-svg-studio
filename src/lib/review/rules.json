{
  "libraryVersion": 3,
  "referenceCanvas": {
    "width": 1920,
    "height": 1080,
    "note": "几何阈值为 px@1080p，实际按 scale = min(W,H)/1080 缩放"
  },
  "coveragePolicy": {
    "rule": "每条写作规则都必须有可算指标（metric + gate）和落地实现；没有 metric 的规则不算规则",
    "noMetric": "无 metric 的规则只能记 severity=human，进人审清单，不计入通过率",
    "silent": "规则已实现但本次没有产出记录时记 UNMEASURED，不得算 PASS；报告必须逐条列出状态"
  },
  "statusVocabulary": [
    "PASS",
    "WARN",
    "FAIL",
    "UNMEASURED",
    "NA",
    "DIAGNOSTIC"
  ],
  "dimensions": {
    "measure": "exact 定义即数值 / model 代理模型，仅序关系可信 / semantic 只能人判",
    "threshold": "standard 可引用规范，改动需换引文 / convention 行业惯例，可辩护无强制力 / proposal 本项目提案，永不阻断",
    "severity": "blocker 值得修 / warn 可讨论 / info 参考",
    "impact": "high 高（做不成）/ medium 中（读不顺）/ low 低（不精致）；只决定排序与展示预算，不决定能不能拦",
    "medium": "video / ui / print",
    "status": "PASS/WARN/FAIL 是闸门结论；DIAGNOSTIC 是诊断输出，不参与判定"
  },
  "impactPolicy": {
    "axis": "影响程度：高=做不成 / 中=读不顺 / 低=不精致；与闸门权限（能不能拦）、媒介（video/ui/print）相互独立",
    "labels": {
      "high": "高",
      "medium": "中",
      "low": "低"
    },
    "byPrinciple": {
      "可读性": "high",
      "可用性": "high",
      "交付完整性": "high",
      "对比": "high",
      "亲密性": "medium",
      "视觉层次": "medium",
      "对齐": "medium",
      "网格": "medium",
      "格式塔·相似": "medium",
      "格式塔·闭合": "medium",
      "格式塔·连续": "medium",
      "共同区域": "medium",
      "负空间": "medium",
      "重复与一致性": "medium",
      "信息密度": "medium",
      "运动与节奏": "medium",
      "统一与多样": "low",
      "平衡": "low",
      "比例": "low",
      "意义": "low"
    },
    "override": {
      "SN-01": "low",
      "OR-01": "low",
      "PN-01": "low",
      "NS-02": "low",
      "TY-07": "medium",
      "TY-08": "medium"
    },
    "fallback": "medium",
    "order": [
      "high",
      "medium",
      "low"
    ],
    "budget": {
      "high": null,
      "medium": 5,
      "low": 0,
      "elementsPerCard": 5,
      "note": "高影响不折叠（一条问题都不该被藏）；中影响按规则聚合成一张卡，超过 5 类折成一行；低影响只给条数与规则 ID"
    },
    "note": "影响程度只做排序与展示预算，不改变 PASS/WARN/FAIL：高影响不等于能拦，低影响也不等于可忽略。完整记录仍在 findings[]，折叠只发生在 view 里"
  },
  "rules": [
    {
      "id": "QL-01",
      "title": "文本溢出",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "overflow_px_1080",
      "unit": "px@1080p",
      "gate": {
        "fail": {
          "gt": 0.5
        }
      },
      "minSamples": 1,
      "requires": [
        "rendered_frame",
        "boxes"
      ],
      "note": "文字 ink 框超出容器或画布；必须在渲染后测，font-size 属性不能推导文本宽度",
      "measure": "exact",
      "threshold": "convention",
      "citation": "溢出为几何事实；0.5px 是抗锯齿容差，属工艺惯例",
      "principle": "可读性",
      "violation": "文字超出容器，边缘被切断，得跳读才能补全。",
      "needsPreciseBoxes": true,
      "needsExactWidth": true
    },
    {
      "id": "QL-02",
      "title": "文本遮挡",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "occlusion_ratio",
      "unit": "ratio",
      "gate": {
        "fail": {
          "gt": 0.03
        },
        "warn": {
          "gt": 0.01
        }
      },
      "minSamples": 1,
      "requires": [
        "rendered_frame",
        "boxes"
      ],
      "note": "文本被更高 z 且不透明（opacity>=0.5）的元素覆盖面积占比；bbox 相交只算 WARN，像素确认后才升 FAIL",
      "measure": "exact",
      "threshold": "proposal",
      "citation": "3%/1% 为提案；且 bbox 相交需像素确认",
      "principle": "可读性",
      "violation": "文字被压住一片面积，笔画缺失，读起来要猜。",
      "needsExactWidth": true
    },
    {
      "id": "QL-03",
      "title": "字号下限",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "font_size_ratio_short_side",
      "unit": "ratio",
      "gate": {
        "fail": {
          "lt": 0.022
        },
        "warn": {
          "lt": 0.035
        }
      },
      "minSamples": 1,
      "requires": [
        "boxes"
      ],
      "gateUI": {
        "metric": "font_size_px",
        "gate": {
          "fail": {
            "lt": 12
          },
          "warn": {
            "lt": 14
          }
        }
      },
      "note": "短边百分比（1080 短边 → pass 38px）是分辨率无关口径；声明 --display-width 时改用 gateUI 的 px 口径，按投放宽度折算：有效字号 = 声明字号 × 投放宽度 / 画布宽。同一张 1600 宽的图按 375 和 800 投放会得出不同结论，报告必须写清用了哪个宽度",
      "measure": "exact",
      "threshold": "convention",
      "citation": "锚点来自 WCAG 大字 24px，换算成短边比例是惯例",
      "principle": "可读性",
      "violation": "正文字号在目标尺寸上掉到看不清，观众直接跳过。",
      "needsPreciseBoxes": true
    },
    {
      "id": "QL-04",
      "title": "行高",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "line_height_ratio",
      "unit": "ratio",
      "gate": {
        "fail": {
          "lt": 1.4
        },
        "warn": {
          "lt": 1.5
        }
      },
      "minSamples": 1,
      "requires": [
        "boxes"
      ],
      "gateDisplay": {
        "metric": "line_height_ratio_display",
        "gate": {
          "fail": {
            "lt": 1.02
          },
          "warn": {
            "lt": 1.08
          }
        }
      },
      "note": "line-height / font-size。正文（< 1.8× 中位字号）按 1.4/1.5；展示级标题的行高随字号收缩，56/64=1.14 是正常排版，必须走 gateDisplay 的 1.02/1.08，否则会把大标题全判成过紧",
      "measure": "exact",
      "threshold": "convention",
      "citation": "排版工艺：正文行高 1.4–1.8；展示级 1.02–1.2，无强制规范",
      "principle": "可读性",
      "violation": "中文行高过紧，上下贴在一起，扫读会串行。",
      "needsPreciseBoxes": true
    },
    {
      "id": "QL-07",
      "title": "资源失效",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "resource_status",
      "unit": "enum",
      "gate": {
        "fail": {
          "in": [
            404,
            "empty",
            "decode_error"
          ]
        }
      },
      "minSamples": 1,
      "requires": [
        "asset_scan"
      ],
      "note": "href 404、空文件、解码失败；字体缺失单独记 UNMEASURED 而不是 PASS",
      "measure": "exact",
      "threshold": "standard",
      "citation": "定义性：资源不可解码即不存在；无阈值可争",
      "principle": "交付完整性",
      "violation": "资源 404 或空文件，这一块在成片里是空白。"
    },
    {
      "id": "VS-01",
      "title": "出画 / 安全区",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "out_of_canvas_ratio",
      "unit": "ratio",
      "gate": {
        "fail": {
          "gt": 0
        }
      },
      "minSamples": 1,
      "requires": [
        "boxes"
      ],
      "secondary": {
        "metric": "out_of_safe_ratio",
        "gate": {
          "warn": {
            "gt": 0
          }
        }
      },
      "note": "被画布裁切 → FAIL；出安全区（默认各边 5% 轴长，平台已知则用平台值）→ WARN。合并原 QL-06 ｜ 出画判定带 0.5px@1080p 抗锯齿容差：贴边 bbox 的浮点残差不得判 FAIL（曾因此误报 5 条）。文字宽度为估计值时，出画判定只给 WARN",
      "measure": "exact",
      "threshold": "standard",
      "citation": "画布外内容不可见（定义性）；安全区 5% 本身是提案，只判 WARN",
      "principle": "交付完整性",
      "violation": "元素被画布裁掉一部分，平台端还会再裁一次。",
      "needsPreciseBoxes": true
    },
    {
      "id": "CT-02",
      "title": "文本对比度",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "wcag_contrast",
      "unit": "ratio",
      "gate": {
        "fail": {
          "lt": 4.0
        },
        "warn": {
          "lt": 4.5
        }
      },
      "minSamples": 1,
      "gateLarge": {
        "fail": {
          "lt": 2.5
        },
        "warn": {
          "lt": 3.0
        }
      },
      "requires": [
        "rendered_frame",
        "boxes"
      ],
      "note": "WCAG 2.2 §1.4.3；大字定义：ui 用 CSS px>=24（声明 --display-width 时按投放宽度折算），位图/印刷用『相对正文 >=1.8x 中位数』。必须在成片上测，属性色不能代表屏幕色。取样先腐蚀 1px 去掉抗锯齿边缘，再取远尾中位色；否则细字会被边缘像素拉成中间灰，13.4:1 报成 3.2:1",
      "measure": "exact",
      "threshold": "standard",
      "citation": "WCAG 2.2 §1.4.3 AA：4.5:1，大字 3:1",
      "principle": "对比",
      "violation": "文字与底色太接近，小字在压缩后基本消失。"
    },
    {
      "id": "DE-01",
      "title": "死元素",
      "severity": "blocker",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "visible_frame_count",
      "unit": "frames",
      "gate": {
        "fail": {
          "lte": 0
        }
      },
      "minSamples": 1,
      "requires": [
        "boxes"
      ],
      "note": "声明存在但全程不可见/面积 0/完全不透明 0。注意入场前不可见是合法的，判的是全程",
      "measure": "exact",
      "threshold": "standard",
      "citation": "定义性：全程零可见 = 零信息",
      "principle": "意义",
      "violation": "元素声明了却全程不可见，占位不出内容。"
    },
    {
      "id": "TM-01",
      "title": "阅读速度",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "cps",
      "unit": "chars/s",
      "gate": {
        "fail": {
          "gt": 9
        },
        "warn": {
          "gt": 7
        }
      },
      "minSamples": 1,
      "requires": [
        "timeline",
        "text_segments"
      ],
      "gateLatin": {
        "fail": {
          "gt": 20
        },
        "warn": {
          "gt": 17
        }
      },
      "note": "中文 5-7 字/秒舒适、9 为上限；西文 17-20。有旁白时取 max(阅读, 旁白) 后再判，允许 +1 容差 ｜ 当前 scope=static，本条停用",
      "measure": "exact",
      "threshold": "convention",
      "citation": "字幕实践 5–9 字/秒；无强制标准，个体差异大",
      "principle": "可读性",
      "violation": "字数超出停留时长，观众读不完就被切走。",
      "outOfScope": "video"
    },
    {
      "id": "TM-04",
      "title": "物理起点",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "start_scale",
      "unit": "ratio",
      "gate": {
        "fail": {
          "lte": 0.02
        }
      },
      "minSamples": 1,
      "requires": [
        "timeline"
      ],
      "note": "禁止从 scale(0) 起；建议 0.9-0.97 + opacity。transform-origin 须在锚点（按钮/卡片边缘）",
      "measure": "exact",
      "threshold": "convention",
      "citation": "动效工艺：禁 scale(0) 是通行做法",
      "principle": "运动与节奏",
      "violation": "从 scale(0) 起，物体凭空出现，物理上不成立。"
    },
    {
      "id": "TM-10",
      "title": "空白帧",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "blank_frame_ratio",
      "unit": "ratio",
      "gate": {
        "fail": {
          "gt": 0.1
        },
        "warn": {
          "gt": 0.05
        }
      },
      "minSamples": 1,
      "requires": [
        "frames_sampled"
      ],
      "note": "空白 = 墨量 < 0.5% 且无文本；有意留白只允许出现在转场与停顿，需在报告里给理由 ｜ 当前 scope=static，本条停用",
      "measure": "exact",
      "threshold": "proposal",
      "citation": "10%/5% 为提案；判的是『无内容』不是『留白』",
      "principle": "交付完整性",
      "violation": "大面积没有内容的帧，观众在看空屏。",
      "outOfScope": "video"
    },
    {
      "id": "FT-01",
      "title": "触控目标",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "target_size_px",
      "unit": "px",
      "gate": {
        "fail": {
          "lt": 44
        },
        "warn": {
          "lt": 48
        }
      },
      "minSamples": 1,
      "requires": [
        "interaction_map"
      ],
      "note": "iOS HIG 44x44pt、Material 48x48dp。视频媒介不适用，medium 过滤后自动 NA",
      "measure": "exact",
      "threshold": "standard",
      "citation": "Apple HIG 44×44pt；Material 48×48dp",
      "principle": "可用性",
      "violation": "点击区太小，手指按不准，误触率上升。"
    },
    {
      "id": "PE-01",
      "title": "危险操作防护",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "guard_present",
      "unit": "bool",
      "gate": {
        "fail": {
          "eq": false
        }
      },
      "minSamples": 1,
      "requires": [
        "interaction_map"
      ],
      "note": "删除/覆盖/付费等不可逆操作需二次确认或默认禁用",
      "measure": "exact",
      "threshold": "convention",
      "citation": "防错是通行启发式，非规范条文",
      "principle": "可用性",
      "violation": "危险操作没有确认或默认禁用，误触即不可逆。"
    },
    {
      "id": "SV-01",
      "title": "状态反馈",
      "severity": "blocker",
      "medium": [
        "ui"
      ],
      "metric": "feedback_latency_ms",
      "unit": "ms",
      "gate": {
        "fail": {
          "gt": 100
        }
      },
      "minSamples": 1,
      "requires": [
        "interaction_map"
      ],
      "note": "100ms 内出现反馈元素；超过 1s 需 loading 态。慢接口不算违规，无反馈才算",
      "measure": "exact",
      "threshold": "standard",
      "citation": "Nielsen 响应时间上限 0.1s",
      "principle": "可用性",
      "violation": "操作后没有即时反馈，用户会重复点。"
    },
    {
      "id": "AL-01",
      "title": "对齐",
      "severity": "warn",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "align_dev_p90",
      "unit": "px@1080p",
      "gate": {
        "warn": {
          "gt": 6
        }
      },
      "minSamples": 4,
      "requires": [
        "boxes",
        "groups"
      ],
      "note": "组内左/中/基线聚类的稳健偏差（p90），不用 std（单个离群值就失效）。样本 <4 记 UNMEASURED",
      "measure": "exact",
      "threshold": "proposal",
      "citation": "6px/2px 与 p90 口径均为提案",
      "principle": "对齐",
      "violation": "同组元素边缘不在一条线上，视线每行都要重找起点。",
      "needsPreciseBoxes": true
    },
    {
      "id": "AL-02",
      "title": "规则线定位",
      "severity": "warn",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "rule_line_gap_delta_px",
      "unit": "px@1080p",
      "gate": {
        "warn": {
          "gt": 8
        }
      },
      "minSamples": 1,
      "requires": [
        "boxes"
      ],
      "secondary": {
        "metric": "rule_line_offset_spread",
        "gate": {
          "warn": {
            "gt": 8
          }
        }
      },
      "note": "分隔线（细长横/竖线）上下留白之差，全图取最大者；同类线之间的上留白极差 >8px 另报一条。实测顶部线 31.6/72.4、中间线 59.6/60.4，此前没有任何规则管这个",
      "measure": "exact",
      "threshold": "proposal",
      "citation": "8px 为提案：规则线应视觉居中，光学偏移容忍 1–2px，8px 已是一贴一浮",
      "principle": "对齐",
      "violation": "分隔线一侧贴住内容、另一侧悬空，读者会把线读成上面内容的底边或下面内容的下划线。",
      "needsPreciseBoxes": true
    },
    {
      "id": "PR-01",
      "title": "亲密性",
      "severity": "warn",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "gap_ratio",
      "unit": "ratio",
      "gate": {
        "warn": {
          "lt": 1.2
        }
      },
      "minSamples": 3,
      "requires": [
        "boxes"
      ],
      "note": "旧的聚类口径：最近邻间距一维聚类出两簇，比 = 簇间 / 簇内。已由 GR-02 取代，本版不再单独判定，保留 ID 供旧报告比对——聚类在 1.2 附近分不开，正是「跑不出来也不报」的来源",
      "supersededBy": "GR-02",
      "measure": "model",
      "threshold": "proposal",
      "citation": "1.2/1.5 为提案；分组依赖聚类模型",
      "principle": "亲密性",
      "violation": "组间间距不大于组内间距，两块内容被读成一组。"
    },
    {
      "id": "GR-02",
      "title": "分组间距比",
      "severity": "warn",
      "medium": [
        "ui",
        "print"
      ],
      "metric": "group_gap_ratio",
      "unit": "ratio",
      "gate": {
        "warn": {
          "lt": 1.8
        }
      },
      "minSamples": 3,
      "requires": [
        "boxes",
        "groups"
      ],
      "note": "组间缝 / 组内间距；组间取最窄的一条缝（最弱处决定分组）。分组来自 <g>/group/container；缺分组声明时记 UNMEASURED，不退回聚类（聚类在 1.2 附近分不开）。实测 0.77、1.23 粘连，2.78 分开，1.8 是分界",
      "measure": "exact",
      "threshold": "proposal",
      "citation": "『组间明显大于组内』是格式塔接近性的通行做法；1.8 是本库在真实样本上校准的提案值，不是规范数字",
      "principle": "亲密性",
      "violation": "组间缝不比组内间距宽，两块内容被读成一组，分组只能靠猜。",
      "needsPreciseBoxes": true
    },
